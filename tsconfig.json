{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/index.css",
    "src/types/**/*.ts",
    "src/vite-env.d.ts",
    "src/lib/mockData.ts",
    "src/features/auth/demoAuth.ts",
    "src/features/coach/studentState.ts",
    "src/features/coach/StudentManagement.tsx",
    "src/features/metrics/MetricsDashboard.tsx",
    "src/features/tournaments/tournamentState.ts",
    "src/features/tournaments/TournamentList.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
